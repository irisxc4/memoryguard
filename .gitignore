.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 数据库 Fixture 例外（与 CI repo-hygiene 的 tests/fixtures 豁免保持一致）
!tests/fixtures/**/*.db
!tests/fixtures/**/*.db3
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.vscdb
