*.bak-*
*.bak_*
*.swp
*~

# 本地修补/验收脚手架（不得进入发布树）
/.self-eval-scores.jsonl
/CLAUDE_HANDOFF_*.md
/NUL
/_*.py
/_*.txt
/dist_builtin_graphify*/
/fix_cursor_hooks_bom.ps1

# 本地日志
*.log
logs/
tmp/
temp/

# MemoryGuard 运行时产物（可完全删除，非事实源）
.memoryguard/
/mcp-runtime/

# 本机 Agent 接管配置与派生图谱（不得发布）
/.codex/
/.cursor/
/.trae/
/.claude/
/.windsurf/
/.learnings/
graphify-out/

# 命令入口按用户调整
/AGENTS.md

